# ---- Database ----
# Local SQLite file (default). For production you can keep a file on your VPS,
# or use Turso (hosted SQLite, free tier): libsql://your-db.turso.io
DATABASE_URL="file:./data/store.db"
DATABASE_AUTH_TOKEN=""

# ---- Admin login ----
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"
# First admin account, created by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- PayHere (leave MERCHANT_ID empty to hide card payment) ----
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
# "true" while testing with the sandbox, "false" when live
PAYHERE_SANDBOX="true"
