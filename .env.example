# ---- Database ----
# Local SQLite file (default). For production you can keep a file on your VPS,
# or use Turso (hosted SQLite, free tier): libsql://your-db.turso.io
DATABASE_URL="file:./data/store.db"
DATABASE_AUTH_TOKEN=""

# ---- Admin login ----
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"
# First admin account, created by `npm run db:seed`
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- PayHere (leave MERCHANT_ID empty to hide card payment) ----
PAYHERE_MERCHANT_ID=""
PAYHERE_MERCHANT_SECRET=""
# "true" while testing with the sandbox, "false" when live
PAYHERE_SANDBOX="true"

# ---- Customer accounts (Better Auth) ----
# Optional: falls back to AUTH_SECRET. Use a different long random string in production.
BETTER_AUTH_SECRET=""
# Optional "Continue with Google" (https://console.cloud.google.com → Credentials → OAuth client)
# Authorised redirect URI: <NEXT_PUBLIC_SITE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Emails (https://resend.com) ----
# Leave empty in development: emails are printed in the terminal instead.
RESEND_API_KEY=""
# Must be on a domain you verified in Resend, e.g. "KESH <orders@kesh.lk>"
EMAIL_FROM=""
# Where new-order alerts go (defaults to the store email in src/lib/config.ts)
ADMIN_NOTIFY_EMAIL=""

# ---- Analytics (optional) ----
NEXT_PUBLIC_GA_ID=""            # e.g. G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=""    # e.g. 123456789012345
